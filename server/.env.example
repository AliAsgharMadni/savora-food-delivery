# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=*

# Supabase Admin Configuration
# Required for server-side trusted DB updates from webhooks
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration (Server-Side Secrets - NEVER expose to Flutter)
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

